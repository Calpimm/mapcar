    "@scalar/fastify-api-reference": "1.75.0",
    "fastify": "5.12.7",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "pino-pretty": "13.2.0",
